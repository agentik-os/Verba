# Verba site — copy to .env.local and fill in. All Stripe values come from the
# SHARED Stripe account (same one as LiquidPad). Create two NEW recurring prices
# for Verba and put their IDs here — only these IDs grant a Verba subscription,
# so other products on the account never unlock Verba.

NEXT_PUBLIC_SITE_URL=https://verba.run

STRIPE_SECRET_KEY=sk_live_or_test_xxx
STRIPE_PRICE_VERBA_MONTHLY=price_xxx
STRIPE_PRICE_VERBA_ANNUAL=price_xxx

# Optional — for the webhook signature check (otherwise the webhook is a no-op ack)
STRIPE_WEBHOOK_SECRET=whsec_xxx
